# Copy to .env and fill in only what you use. Never commit .env (it is in .gitignore).
# Values are synthetic examples (design §12.5).

# api
PORT=3000
DATA_DIR=./data

# HMAC salt of the opaque userRef (REQ-SEC-05). Without it, a random salt per process is used.
REDACTION_SALT=change-me-local-only

# Timeout of each LLM call, in milliseconds (REQ-ESC-04, REQ-COM-06).
LLM_TIMEOUT_MS=30000

# Azure OpenAI (REQ-LLM-01): used when the endpoint, the key and the deployment are all set.
AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# DeepSeek (REQ-LLM-02): used when Azure OpenAI is not configured and the key is set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# vpn-diagnostics skill: default target and targets allowed in prompt runs (REQ-SEC-14).
VPN_GATEWAY_TARGET=vpn-gw.example.internal:443
VPN_ALLOWED_TARGETS=vpn-gw.example.internal:443,localhost:8443
